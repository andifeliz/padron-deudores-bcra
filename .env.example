# Variables que se pueden cambiar. Opcional: sin .env, docker compose usa estos mismos valores por defecto.
# Para cambiar alguno, copiá este archivo como .env y editalo.
# Son valores de desarrollo local: en un ambiente real, las credenciales son obligatorias y salen de un gestor de secretos.

# --- Red ---
# Dónde se publican los puertos: 127.0.0.1 = solo esta máquina. Con 0.0.0.0 quedan abiertos a toda la red (con las contraseñas de abajo).
PUERTOS_IP=127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=padron
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DB_IMPORTADOR_PASSWORD=importador
DB_CONSULTA_PASSWORD=consulta

# --- LocalStack (S3 y SQS) ---
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET=padron-archivos
SQS_COLA=importaciones
SQS_COLA_FALLIDOS=importaciones-fallidas
SQS_MAX_INTENTOS=3

# --- Servicios .NET ---
IMPORTADOR_API_PORT=5001
UPLOAD_MAXIMO_MIB=8192
CONSULTA_API_PORT=5002
TOP_MAXIMO=1000

# --- Receptor de webhook (demo) ---
WEBHOOK_PORT=8080
WEBHOOK_URL=http://webhook-receptor:8080/importaciones
